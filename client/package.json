{
  "name": "ta-cu-client",
  "version": "0.0.1",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --tunnel\"",
    "start:lan": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --lan\"",
    "android": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --android --tunnel\"",
    "android:lan": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --android --lan\"",
    "ios": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --ios --tunnel\"",
    "ios:lan": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; npx expo start --ios --lan\"",
    "web": "powershell -NoProfile -Command \"$env:EXPO_USE_NODE_EXTERNALS='0'; $env:EXPO_OFFLINE='1'; $env:EXPO_NO_DEPENDENCY_VALIDATION='1'; npx expo start --web\"",
    "build:web": "EXPO_USE_NODE_EXTERNALS=0 EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 npx expo export --platform web\""
  },
  "dependencies": {
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.3.29",
    "axios": "1.7.2",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.10.0",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  }
}
